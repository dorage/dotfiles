{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#4BFF36",
          "foreground": "#333333",
          "leading_powerline_symbol": "",
          "options": {
            "style": "folder"
          },
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#74FAFC",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF5C00{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ee5396{{ end }}",
            "{{ if gt .Ahead 0 }}#E92EFB{{ end }}",
            "{{ if gt .Behind 0 }}#E92EFB{{ end }}"
          ],
          "foreground": "#333333",
          "options": {
            "branch_icon": " ",
            "branch_template": "{{ trunc 25 .Branch }}"
          },
          "powerline_symbol": "",
          "style": "powerline",
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#FFEB01",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "background": "#33b1ff",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "go"
        },
        {
          "background": "#4BFF36",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#ee5396",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "ruby"
        },
        {
          "background": "#ee5396",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "java"
        },
        {
          "background": "#E92EFB",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "julia"
        },
        {
          "background": "#33b1ff",
          "foreground": "#333333",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ .Full }} ",
          "type": "php"
        },
        {
          "background": "#E92EFB",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#33b1ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FF5C00{{end}}",
            "{{if eq \"Full\" .State.String}}#4BFF36{{end}}"
          ],
          "foreground": "#333333",
          "options": {
            "charged_icon": " ",
            "charging_icon": "⇡ ",
            "discharging_icon": "⇣ "
          },
          "powerline_symbol": "",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "type": "battery"
        },
        {
          "background": "#b6b8bb",
          "foreground": "#333333",
          "options": {
            "style": "austin",
            "threshold": 150
          },
          "powerline_symbol": "",
          "style": "powerline",
          "template": " {{ .FormattedMs }} ",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#ee5396",
          "foreground": "#333333",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ .UserName }} ❯ ",
          "trailing_diamond": "",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
