# Copy to .env and fill in. .env is gitignored - this repository is public,
# so no credential may ever be committed here.
#
#   cp .env.example .env

# --- FreshRSS ---------------------------------------------------------------
# Pin a version instead of `latest` once the setup is stable, e.g. 1.27.0
FRESHRSS_IMAGE_TAG=latest
FRESHRSS_PORT=8080
# The original `docker run` used Europe/Paris; Asia/Seoul is probably what you
# actually want. This value is shared by FreshRSS and the backup scheduler.
TZ=Europe/Paris
# Minutes at which FreshRSS refreshes feeds
CRON_MIN=1,31

# --- Cloudflare R2 backup target -------------------------------------------
# Account ID: Cloudflare dashboard -> R2 -> Overview (or `wrangler whoami`).
R2_ACCOUNT_ID=
# R2 API token (S3-compatible credentials), created at
# dashboard -> R2 -> API -> Manage API tokens, permission "Object Read & Write",
# scoped to the bucket below. These are NOT the wrangler OAuth login.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=freshrss-backup
# Key prefix inside the bucket; snapshots land at <prefix>/freshrss-<stamp>.tar.gz
R2_PREFIX=freshrss

# --- Backup schedule --------------------------------------------------------
# 3600 = hourly. The scheduler aligns to interval boundaries.
BACKUP_INTERVAL_SECONDS=3600
# Take a snapshot immediately on container start instead of waiting a full cycle
BACKUP_ON_START=true
# Snapshots older than this are pruned from R2 after each successful upload.
# Set to 0 to keep everything forever.
BACKUP_RETENTION_DAYS=30
